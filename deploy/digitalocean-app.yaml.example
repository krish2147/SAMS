name: sams-membership
region: blr

services:
  - name: web
    github:
      repo: krish2147/SAMS
      branch: main
      deploy_on_push: true
    source_dir: /
    dockerfile_path: ./Dockerfile
    http_port: 3000
    instance_size_slug: apps-s-1vcpu-1gb
    instance_count: 1
    health_check:
      http_path: /api/health
      initial_delay_seconds: 30
      period_seconds: 10
      timeout_seconds: 5
      success_threshold: 1
      failure_threshold: 5
    envs:
      - key: NODE_ENV
        value: production
        scope: RUN_TIME
      - key: ALLOW_MOCK_DB
        value: "false"
        scope: RUN_TIME
      - key: REQUIRE_OBJECT_STORAGE
        value: "true"
        scope: RUN_TIME
      - key: APP_URL
        value: ${_self.PUBLIC_URL}
        scope: RUN_TIME
      - key: APP_BASE_URL
        value: ${_self.PUBLIC_URL}
        scope: RUN_TIME
      - key: ALLOWED_ORIGINS
        value: ${_self.PUBLIC_URL}
        scope: RUN_TIME
      - key: DB_HOST
        value: ${sams-db.HOSTNAME}
        scope: RUN_TIME
      - key: DB_PORT
        value: ${sams-db.PORT}
        scope: RUN_TIME
      - key: DB_USER
        value: ${sams-db.USERNAME}
        scope: RUN_TIME
      - key: DB_PASSWORD
        value: ${sams-db.PASSWORD}
        scope: RUN_TIME
        type: SECRET
      - key: DB_NAME
        value: ${sams-db.DATABASE}
        scope: RUN_TIME
      - key: DB_CA_CERT
        value: ${sams-db.CA_CERT}
        scope: RUN_TIME
        type: SECRET

databases:
  - name: sams-db
    engine: MYSQL
    version: "8"
    production: true
    cluster_name: REPLACE_WITH_MANAGED_MYSQL_CLUSTER_NAME
    db_name: bsfms_db
    db_user: sams_app

alerts:
  - rule: DEPLOYMENT_FAILED
  - rule: DOMAIN_FAILED
