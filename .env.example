# Runtime
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
ALLOW_MOCK_DB=true
REQUIRE_OBJECT_STORAGE=false
UPLOAD_DIR=./uploads
ALLOWED_ORIGINS=http://localhost:3000

# MySQL (required in production)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bsfms_db
DB_CONNECTION_LIMIT=20
DB_CONNECT_TIMEOUT_MS=10000
DB_CA_CERT=
NOTIFICATION_POLL_INTERVAL_MS=15000

# Required only for a new, empty production database
INITIAL_ADMIN_NAME=System Administrator
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-at-least-12-characters
INITIAL_ADMIN_PHONE=919999999999

# Optional local-only administrator used by the mock/development database
DEV_ADMIN_NAME=Development Administrator
DEV_ADMIN_EMAIL=admin@example.test
DEV_ADMIN_PASSWORD=replace-with-a-local-password
DEV_ADMIN_PHONE=910000000000

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public base URL used to build links sent to members (invoices, payment links).
# Must be the real HTTPS domain in production - never a tunnel URL.
PUBLIC_BASE_URL=https://example.com

# MSG91 shared credentials
# MSG91_AUTH_KEY is the current name; MSG91_AUTHKEY is still read as a fallback.
MSG91_AUTH_KEY=
MSG91_AUTHKEY=

# MSG91 SMS OTP (DLT-regulated in India)
# Sender must be the DLT-approved 6-char header, and MSG91_OTP_DLT_TEMPLATE_ID the
# approved DLT content template id. Sent via sendhttp; the /api/v5/otp product is
# deliberately not used because it reports success without delivering.
MSG91_SENDER_ID=
MSG91_OTP_DLT_TEMPLATE_ID=

# Secret for hashing phone numbers and OTPs at rest.
# REQUIRED in production - generate with: openssl rand -hex 32
# Leaving this unset falls back to a known development value, which makes stored
# OTP hashes forgeable.
OTP_HASH_SECRET=

# Signing secret for member-facing invoice download links.
INVOICE_LINK_SECRET=

# MSG91 WhatsApp
MSG91_WHATSAPP_NUMBER=
MSG91_WHATSAPP_NAMESPACE=
MSG91_WHATSAPP_LANGUAGE=en
MSG91_PAYMENT_LINK_TEMPLATE=payment_link
MSG91_PAYMENT_SUCCESS_TEMPLATE=payment_success
MSG91_INVOICE_TEMPLATE=payment_invoice
# Comma-separated body variable order, must match the approved Meta template exactly.
MSG91_PAYMENT_LINK_BODY_FIELDS=
MSG91_PAYMENT_SUCCESS_BODY_FIELDS=
MSG91_INVOICE_BODY_FIELDS=

# Legacy MSG91 names, still read as fallbacks by older code paths
MSG91_INTEGRATED_NUMBER=
WHATSAPP_TEMPLATE_NAME=payment_link
WHATSAPP_NAMESPACE=

# DANGER - local development only. Must be absent or false in production.
# These would allow logging in without a real OTP if the bypass is implemented.
DEV_MEMBER_OTP_BYPASS=false
DEV_MEMBER_OTP_CODE=

# DigitalOcean Spaces (required when running more than one app instance)
SPACES_BUCKET=
SPACES_REGION=blr1
SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=

# Optional integrations
GEMINI_API_KEY=
